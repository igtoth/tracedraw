<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 desktop rescap">

  <Identity Name="{IDENTITY}" Publisher="{PUBLISHER}" Version="{VERSION}" ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>TraceDraw</DisplayName>
    <PublisherDisplayName>{PUBLISHER_NAME}</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
    <Resource Language="pt-br" />
    <Resource Language="es-es" />
    <Resource Language="fr-fr" />
    <Resource Language="de-de" />
    <Resource Language="zh-cn" />
    <Resource Language="ja-jp" />
    <Resource Language="ru-ru" />
    <Resource Language="ar-sa" />
    <Resource Language="hi-in" />
    <Resource Language="bn-bd" />
    <Resource Language="id-id" />
  </Resources>

  <Applications>
    <Application Id="TraceDraw" Executable="tracedraw.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="TraceDraw"
        Description="Open-source vector editor"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" Square310x310Logo="Assets\Square310x310Logo.png" />
      </uap:VisualElements>
      <Extensions>
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="tdraw">
            <uap:DisplayName>TraceDraw Document</uap:DisplayName>
            <uap:SupportedFileTypes>
              <uap:FileType>.tdraw</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="cdr">
            <uap:DisplayName>CDR drawing</uap:DisplayName>
            <uap:SupportedFileTypes>
              <uap:FileType>.cdr</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>
        <!-- The command-line alias runs tracedraw-cli.exe, a console program,
             so it keeps its terminal input and output. It hangs on the main
             app because the Store refuses a second application hidden from
             the Start menu (a "headless app") without a waiver, and an
             application may declare only one alias extension. -->
        <uap3:Extension Category="windows.appExecutionAlias" Executable="tracedraw-cli.exe" EntryPoint="Windows.FullTrustApplication">
          <uap3:AppExecutionAlias>
            <desktop:ExecutionAlias Alias="tracedraw-cli.exe" />
          </uap3:AppExecutionAlias>
        </uap3:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
