<?xml version="1.0" encoding="utf-8"?>
<!-- The Android app (docs/behavior/android.md): the system's NativeActivity
     loads libtracedraw.so, the editor compiled as a shared library, which
     draws and reads touch input itself. The version code and name are
     filled in by scripts/android/build.sh from Cargo.toml. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.tracedraw.app">

    <!-- Android 7.0 (API 24) and later; the build sets the target too. -->
    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="34" />

    <!-- Tablets, phones, Chromebooks: a touch screen is not required (a
         mouse and keyboard work as on the desktop). -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.faketouch" android:required="false" />
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />

    <!-- Updates and the AI Drawing service (ureq) need the network;
         nothing else does. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="TraceDraw"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="true"
        android:hasCode="false"
        android:extractNativeLibs="true"
        android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen">
        <activity
            android:name="android.app.NativeActivity"
            android:label="TraceDraw"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="unspecified"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|screenLayout|smallestScreenSize|uiMode|locale|layoutDirection|navigation">
            <!-- The library the activity loads: lib/arm64-v8a/libtracedraw.so. -->
            <meta-data android:name="android.app.lib_name" android:value="tracedraw" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
